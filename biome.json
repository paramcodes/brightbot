{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/**",
      "tools/**",
      "*.json",
      "*.ts",
      "*.tsx",
      "!**/dist",
      "!.spike",
      "!.worktrees",
      "!orchestrate",
      "!**/*.cast",
      "!**/*.gif",
      "!**/*.png",
      "!**/generated",
      "!packages/server/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "rules": {
      "recommended": true,
      "complexity": {
        "noForEach": "error",
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useNodejsImportProtocol": "error",
        "noParameterAssign": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
