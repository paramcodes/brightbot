{
  "name": "nightcode",
  "private": true,
  "type": "module",
  "description": "Night Code: an open-source terminal coding agent.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run --cwd packages/cli dev",
    "nightcode": "bun run --cwd packages/cli dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test packages",
    "coverage": "bun test packages --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.1",
    "typescript": "^5.9.3"
  }
}
